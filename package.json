{
  "name": "ai-i18n-tools",
  "version": "1.8.0",
  "packageManager": "pnpm@11.12.0",
  "description": "Unified internationalization toolkit for Node.js apps and documentation with AI translation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    }
  },
  "bin": {
    "ai-i18n-tools": "bin/ai-i18n-tools.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "data/",
    "README.md",
    "docs/ai-i18n-tools-context.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/ensure-built.mjs",
    "build": "node scripts/write-build-info.mjs && echo '1/5' && tsc && echo '2/5' && node scripts/chmod-cli-bin.mjs && echo '3/5' && node scripts/copy-runtime-ui-languages-json.mjs && echo '4/5' && node scripts/copy-dashboard-app.mjs && echo '5/5' && node scripts/copy-i18n-locales.mjs && echo 'Build completed successfully\n'",
    "dev": "node scripts/copy-runtime-ui-languages-json.mjs && node scripts/copy-dashboard-app.mjs && node scripts/copy-i18n-locales.mjs && tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . && pnpm run typecheck",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist/",
    "clean:workspace": "bash scripts/clean-workspace.sh",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test",
    "pre-release": "bash scripts/pre-release.sh",
    "docs:sync": "node bin/ai-i18n-tools.mjs translate-docs --path docs/index.md",
    "docs:dev": "node scripts/escape-vue-braces-in-docs.mjs && vitepress dev docs --host",
    "docs:build": "node scripts/escape-vue-braces-in-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:publish": "bash scripts/publish-docs.sh",
    "update-tocs": "doctoc --update-only *.md dev/*.md",
    "i18n:self": "node bin/ai-i18n-tools.mjs -c ai-i18n-self.config.json sync-ui",
    "i18n:sync": "node bin/ai-i18n-tools.mjs sync --path docs/index.md",
    "i18n:translate:sync": "node bin/ai-i18n-tools.mjs sync",
    "i18n:update-headings": "node bin/ai-i18n-tools.mjs write-heading-ids",
    "i18n:status": "node bin/ai-i18n-tools.mjs status",
    "i18n:dashboard": "node bin/ai-i18n-tools.mjs dashboard",
    "i18n:cleanup": "node bin/ai-i18n-tools.mjs cleanup",
    "update-all": "bash scripts/update-all.sh",
    "clean-temp": "node bin/ai-i18n-tools.mjs clean-temp",
    "release:github": "bash scripts/release.sh",
    "release:github:dry": "bash scripts/release.sh --dry-run",
    "notices:write": "node scripts/write-third-party-notices.js"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "ai",
    "auto-translation",
    "react",
    "docusaurus",
    "openrouter",
    "localization",
    "multilingual",
    "cli",
    "markdown"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsj-br/ai-i18n-tools.git"
  },
  "bugs": {
    "url": "https://github.com/wsj-br/ai-i18n-tools/issues"
  },
  "homepage": "https://wsj-br.github.io/ai-i18n-tools/",
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.4",
    "ai": "^7.0.21",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.1",
    "emoji-regex": "^10.6.0",
    "express": "^5.2.1",
    "get-east-asian-width": "^1.6.0",
    "i18next-scanner": "^4.6.0",
    "ignore": "^7.0.6",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "minimatch": "^10.2.5",
    "remove-markdown": "^0.6.4",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0"
  }
}
