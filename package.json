{
  "name": "ai-i18n-tools",
  "version": "1.2.8",
  "packageManager": "pnpm@10.33.2",
  "description": "Unified internationalization toolkit for Node.js apps and documentation with AI translation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    }
  },
  "bin": {
    "ai-i18n-tools": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "docs/",
    "translated-docs/",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/write-build-info.mjs && tsc && node scripts/chmod-cli-bin.mjs && node scripts/copy-runtime-ui-languages-json.mjs && node scripts/copy-edit-cache-app.mjs",
    "build:ui-languages-master": "node --env-file-if-exists=.env scripts/build-ui-languages-complete.mjs",
    "dev": "node scripts/copy-runtime-ui-languages-json.mjs && node scripts/copy-edit-cache-app.mjs && tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . && pnpm run typecheck",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint \"*.md\" \"dev/*.md\" \"docs/*.md\" \"examples/console-app/*.md\" \"examples/nextjs-app/*.md\" \"examples/nextjs-app/docs-site/docs/*.md\"",
    "lint:md:fix": "markdownlint \"*.md\" \"dev/*.md\" \"docs/*.md\" \"examples/console-app/*.md\" \"examples/nextjs-app/*.md\" \"examples/nextjs-app/docs-site/docs/*.md\" -f",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist/",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test",
    "pre-release": "pnpm run format && pnpm run lint && pnpm run clean && pnpm run build && pnpm test",
    "i18n:extract": "ai-i18n-tools extract",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:translate:ui": "ai-i18n-tools translate-ui",
    "i18n:translate:svg": "ai-i18n-tools translate-svg",
    "i18n:translate:docs": "ai-i18n-tools translate-docs",
    "i18n:status": "ai-i18n-tools status",
    "i18n:editor": "ai-i18n-tools editor",
    "i18n:cleanup": "ai-i18n-tools cleanup",
    "update-all": "pnpm build && ai-i18n-tools cleanup && cd examples/console-app && ai-i18n-tools cleanup && cd ../nextjs-app && ai-i18n-tools cleanup",
    "clean-temp": "find . \\( -name '*.log' -o -name 'cache.db.backup*.sqlite' \\) -print && read -p '\nDelete these files? (y/n) ' ans && [ \"$ans\" = \"y\" ] && find . \\( -name '*.log' -o -name 'cache.db.backup*.sqlite' \\) -delete",
    "release:github": "bash scripts/release.sh",
    "release:github:dry": "bash scripts/release.sh --dry-run"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "ai",
    "auto-translation",
    "react",
    "docusaurus",
    "openrouter",
    "localization",
    "multilingual",
    "cli",
    "markdown"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsj-br/ai-i18n-tools.git"
  },
  "bugs": {
    "url": "https://github.com/wsj-br/ai-i18n-tools/issues"
  },
  "homepage": "https://github.com/wsj-br/ai-i18n-tools#readme",
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/types": "^7.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "csv-parse": "^6.2.1",
    "emoji-regex": "^10.6.0",
    "express": "^5.2.1",
    "gray-matter-es": "^0.2.1",
    "i18next-scanner": "^4.6.0",
    "ignore": "^7.0.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "remove-markdown": "^0.6.3",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.6.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.33.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "uuid@<14.0.0": ">=14.0.0",
      "postcss@<8.5.10": ">=8.5.10"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
