{
  "name": "ai-i18n-tools",
  "version": "1.6.1",
  "packageManager": "pnpm@11.7.0",
  "description": "Unified internationalization toolkit for Node.js apps and documentation with AI translation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    }
  },
  "bin": {
    "ai-i18n-tools": "bin/ai-i18n-tools.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "data/",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/ensure-built.mjs",
    "build": "node scripts/write-build-info.mjs && tsc && node scripts/chmod-cli-bin.mjs && node scripts/copy-runtime-ui-languages-json.mjs && node scripts/copy-dashboard-app.mjs",
    "build:ui-languages-master": "node --env-file-if-exists=.env scripts/build-ui-languages-complete.mjs",
    "dev": "node scripts/copy-runtime-ui-languages-json.mjs && node scripts/copy-dashboard-app.mjs && tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . && pnpm run typecheck",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdown-link-check -q -c .markdown-link-check.json README.md dev/*.md docs/*.md examples/console-app/*.md examples/nextjs-app/*.md examples/nextjs-app/docs-site/docs/*.md examples/astro-docs/*.md examples/astro-docs/src/content/docs/*.md examples/astro-docs/src/content/docs/*.mdx",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist/",
    "clean:workspace": "bash scripts/clean-workspace.sh",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test",
    "pre-release": "pnpm run format && pnpm run lint && pnpm run clean && pnpm run build && pnpm test && pnpm --dir examples/nextjs-app/docs-site build && pnpm --dir examples/astro-docs build && pnpm --dir examples/astro-website build",
    "i18n:extract": "ai-i18n-tools extract",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:translate:ui": "ai-i18n-tools translate-ui",
    "i18n:translate:svg": "ai-i18n-tools translate-svg",
    "i18n:translate:docs": "ai-i18n-tools translate-docs",
    "i18n:status": "ai-i18n-tools status",
    "i18n:dashboard": "ai-i18n-tools dashboard",
    "i18n:cleanup": "ai-i18n-tools cleanup",
    "update-all": "pnpm build && ai-i18n-tools cleanup && cd examples/console-app && ai-i18n-tools cleanup && cd ../nextjs-app && ai-i18n-tools cleanup && cd ../astro-docs && ai-i18n-tools cleanup",
    "clean-temp": "ai-i18n-tools clean-temp",
    "release:github": "bash scripts/release.sh",
    "release:github:dry": "bash scripts/release.sh --dry-run",
    "notices:write": "node scripts/write-third-party-notices.js"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "ai",
    "auto-translation",
    "react",
    "docusaurus",
    "openrouter",
    "localization",
    "multilingual",
    "cli",
    "markdown"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsj-br/ai-i18n-tools.git"
  },
  "bugs": {
    "url": "https://github.com/wsj-br/ai-i18n-tools/issues"
  },
  "homepage": "https://github.com/wsj-br/ai-i18n-tools#readme",
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@babel/parser": "^8.0.0",
    "@babel/types": "^8.0.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.0",
    "emoji-regex": "^10.6.0",
    "express": "^5.2.1",
    "i18next-scanner": "^4.6.0",
    "ignore": "^7.0.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "minimatch": "^10.2.5",
    "remove-markdown": "^0.6.4",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "markdown-link-check": "^3.14.2",
    "prettier": "^3.8.4",
    "semver": "^7.7.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0"
  }
}
