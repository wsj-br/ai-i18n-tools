{
  "sourceLocale": "en-GB",
  "targetLocales": ["de", "es", "fr", "hi", "ja", "ko", "pt-BR", "zh-Hans", "zh-Hant"],
  "concurrency": 4,
  "batchConcurrency": 4,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "uiBatchConcurrency": 5,
  "provider": "openrouter",
  "providers": {
    "openrouter": {
      "translationModels": [
        "openai/gpt-5.4",
        "deepseek/deepseek-v4-pro",
        "google/gemini-3.5-flash",
        "tencent/hy-mt2-30b-a3b",
        "mistralai/mistral-large",
        "openai/gpt-4o-mini",
        "cohere/command-r-plus-08-2024",
        "qwen/qwen-2.5-72b-instruct"  
      ],
      "uiModels": [
        "~anthropic/claude-sonnet-latest",
        "qwen/qwen3.7-max"
      ],
      "maxTokens": 8192,
      "temperature": 0.2
    }
  },
  "features": {
    "translateUIStrings": true,
    "translateDocs": false,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "ui": {
    "sourceRoots": ["src/cli", "src/server", "src/dashboard-app"],
    "stringsJson": "src/i18n/strings.json",
    "flatOutputDir": "src/i18n/locales",
    "uiExtractor": {
      "extensions": [".ts", ".js", ".html"],
      "funcNames": ["t"],
      "includePackageDescription": false
    }
  },
  "languagesManifestPath": "src/i18n/locales/ui-languages.json",
  "docs": []
}
