{
  "sourceLocale": "en-GB",
  "targetLocales": ["de", "es", "fr", "hi-Latn", "ja", "ko", "pt-BR", "zh-Hans", "zh-Hant"],
  "concurrency": 5,
  "batchConcurrency": 5,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "provider": "openrouter",
  "providers": {
    "openrouter": {
      "translationModels": [
        "~anthropic/claude-sonnet-latest",
        "openai/gpt-5.5",
        "mistralai/mistral-large-2512",
        "z-ai/glm-5", 
        "qwen/qwen3.7-plus"        
      ],
      "localeModels": [
        { "locale": "ja",      "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "ko",      "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "zh-Hans", "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "zh-Hant", "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] }
      ],
      "maxTokens": 8192,
      "temperature": 0.2,
      "requestTimeoutMs": 60000
    }
  },
  "features": {
    "translateUIStrings": true,
    "translateDocs": false,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "ui": {
    "sourceRoots": ["src/cli", "src/server", "src/dashboard-app"],
    "stringsJson": "src/i18n/strings.json",
    "flatOutputDir": "src/i18n/locales",
    "uiExtractor": {
      "extensions": [".ts", ".js", ".html"],
      "funcNames": ["t"],
      "includePackageDescription": false
    }
  },
  "languagesManifestPath": "src/i18n/locales/ui-languages.json",
  "docs": []
}
