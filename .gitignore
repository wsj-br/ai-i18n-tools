*.tsbuildinfo

# Example apps - track cache.db so clones reuse SQLite cache; ignore other cache dir files
examples/**/.translation-cache/*
!examples/**/.translation-cache/cache.db

# Documentation source (keep only compiled docs)
docs-src/

# VitePress build output
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/
examples/**/.vitepress/cache/
examples/**/.vitepress/dist/
examples/**/.vitepress/.temp/

# Local skills CLI install of this repo's own skills (source is skills/).
# Do not ignore .agents/ entirely: .agents/plugins/marketplace.json is tracked.
.agents/skills/
skills-lock.json

# References to other repositories
references/
# Consumer skill references are distributable source, not external checkouts.
!skills/ai-i18n-tools/references/
!skills/ai-i18n-tools/references/*.md

