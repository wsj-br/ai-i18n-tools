{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "es",
    "fr",
    "de",
    "pt-BR"
  ],
  "concurrency": 4,
  "batchConcurrency": 4,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": true,
    "translateDocs": true,
    "translateSVG": false
  },
  "glossary": {
    "uiGlossary": "locales/strings.json",
    "userGlossary": "glossary-user.csv"
  },
  "ui": {
    "sourceRoots": [
      "src/"
    ],
    "stringsJson": "locales/strings.json",
    "flatOutputDir": "locales/",
    "preferredModel": "openai/gpt-5.4-mini"
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "Project README translated to locale-suffixed files",
      "contentPaths": [
        "README.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": true,
      "docsOutput": {
        "style": "flat",
        "postProcessing": {
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    }
  ],
  "providers": {
    "openrouter": {
      "translationModels": [
        "qwen/qwen3-235b-a22b-2507",
        "openai/gpt-4o-mini",
        "deepseek/deepseek-v4-flash",
        "anthropic/claude-3-haiku",
        "qwen/qwen3.6-plus",
        "anthropic/claude-3.5-haiku",
        "google/gemini-3-flash-preview",
        "~anthropic/claude-haiku-latest",
        "google/gemma-4-31b-it",
        "~anthropic/claude-sonnet-latest",
        "openai/gpt-5.3-codex"
      ],
      "maxTokens": 8192,
      "temperature": 0.2
    }
  },
  "provider": "openrouter"
}
