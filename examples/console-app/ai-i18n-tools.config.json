{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "es",
    "fr",
    "de",
    "pt-BR"
  ],
  "concurrency": 4,
  "batchConcurrency": 4,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": true,
    "translateDocs": true,
    "translateSVG": false
  },
  "glossary": {
    "uiGlossary": "locales/strings.json",
    "userGlossary": "glossary-user.csv"
  },
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-2.5-flash",
        "meta-llama/llama-3.3-70b-instruct",
        "openai/gpt-4o-mini",
        "google/gemma-4-26b-a4b-it",
        "~anthropic/claude-haiku-latest",
        "z-ai/glm-5.2",
        "google/gemini-3.5-flash",
        "~anthropic/claude-sonnet-latest"
      ],
      "uiModels": [
        "openai/gpt-5.4-mini"
      ],
      "maxTokens": 8192,
      "temperature": 0.2
    }
  },
  "provider": "openrouter",
  "ui": {
    "sourceRoots": [
      "src/"
    ],
    "stringsJson": "locales/strings.json",
    "flatOutputDir": "locales/"
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "Project README translated to locale-suffixed files",
      "contentPaths": [
        "README.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": true,
      "docsOutput": {
        "style": "flat",
        "postProcessing": {
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    }
  ]
}
