---
const {
  title,
  description = "AI-powered text tool: translate, rewrite, and transform text using multiple AI providers. Available as a desktop app and self-hosted Docker web app.",
} = Astro.props;
import { resolveUiLanguage } from "../i18n/locale";
import "../styles/global.css";

const ui = resolveUiLanguage(Astro.currentLocale);
---
<!doctype html>
<html lang={ui.code} dir={ui.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Transrewrt`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} | Transrewrt</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
