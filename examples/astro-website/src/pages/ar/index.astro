  <!-- Screenshot tab switcher JS -->
  <script is:inline>
    function switchTab(index) {
      // Hide all panels
      document.querySelectorAll('.screenshot-panel').forEach(el => el.classList.add('hidden'));
      // Deactivate all tabs
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
      // Show selected
      const panel = document.getElementById('screen-' + index);
      if (panel) panel.classList.remove('hidden');
      const tab = document.getElementById('tab-' + index);
      if (tab) tab.classList.add('active');
    }
    function openLightbox(src) {
      const lightbox = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-img');
      if (lightbox && img) {
        img.src = src;
        img.style.transform = 'scale(0.95)';
        lightbox.classList.remove('pointer-events-none', 'opacity-0');
        lightbox.classList.add('opacity-100');
        img.classList.remove('scale-95');
        img.classList.add('scale-100');
        const applyScale = () => {
          if (img.naturalWidth > 0 && img.naturalWidth < 600) {
            img.style.transform = 'scale(1.5)';
          } else {
            img.style.transform = 'scale(1.0)';
          }
        };
        if (img.complete) {
          applyScale();
        } else {
          img.onload = applyScale;
        }
      }
    }
    function closeLightbox() {
      const lightbox = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-img');
      if (lightbox && img) {
        lightbox.classList.remove('opacity-100');
        lightbox.classList.add('opacity-0', 'pointer-events-none');
        img.classList.remove('scale-100');
        img.classList.add('scale-95');
        img.style.transform = 'scale(0.95)';
      }
    }
    // Sticky nav shadow on scroll
    window.addEventListener('scroll', () => {
      const nav = document.getElementById('nav');
      if (nav) {
        if (window.scrollY > 10) {
          nav.style.boxShadow = '0 4px 30px rgba(0,0,0,0.5)';
        } else {
          nav.style.boxShadow = '';
        }
      }
    });
  </script>
