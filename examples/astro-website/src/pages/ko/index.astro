---
import MainLayout from '../../layouts/MainLayout.astro';
import LanguagePicker from '../../components/LanguagePicker.astro';
import { loadFlatBundle, makeT } from '../../i18n/t';
import { resolvePageLocale, useTranslations } from '../../i18n/utils';

const locale = resolvePageLocale(Astro.currentLocale);
const flat = await loadFlatBundle(Astro.currentLocale);
const t = useTranslations(locale, makeT(flat));

const ghBase = 'https://raw.githubusercontent.com/wsj-br/transrewrt/main/images';
const screenshots = [
  { src: `${ghBase}/screenshots/en-GB/translate.png`,             label: t('Translate'),      icon: '🌐' },
  { src: `${ghBase}/screenshots/en-GB/transform-prompt-edit.png`, label: t('Transform'),      icon: '✨' },
  { src: `${ghBase}/screenshots/en-GB/dashboard-summary.png`,     label: t('Dashboard'),      icon: '📊' },
  { src: `${ghBase}/screenshots/en-GB/history.png`,               label: t('History'),        icon: '📋' },
  { src: `${ghBase}/screenshots/en-GB/settings-models.png`,       label: t('Models'),         icon: '⚙️' },
  { src: `${ghBase}/screenshots/en-GB/language-selector.png`,     label: t('Languages'),      icon: '🗺️' },
];
const providers = [
  { name: 'OpenRouter', color: '#a78bfa', free: true },
  { name: 'OpenAI',     color: '#10b981', free: false },
  { name: 'Anthropic',  color: '#f59e0b', free: false },
  { name: 'Gemini',     color: '#3b82f6', free: false },
  { name: 'DeepSeek',   color: '#06b6d4', free: false },
  { name: 'Groq',       color: '#f97316', free: false },
  { name: 'Mistral',    color: '#ec4899', free: false },
  { name: 'xAI',        color: '#6366f1', free: false },
  { name: 'Ollama',     color: '#14b8a6', free: true },
];
---
<MainLayout title="AI 텍스트 도구 – 번역, 재작성 및 변환">
  <!-- ═══════════════════════════════════════════════ NAV ══ -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 glass border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <img src="/logo.svg" alt="Transrewrt 로고" class="w-9 h-7 object-contain transition-all duration-300 group-hover:scale-105" />
        <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-lime-500 via-lime-400 via-orange-400 to-orange-500 bg-clip-text text-transparent">Transrewrt</span>
      </a>
      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="nav-link">기능</a>
        <a href="#providers" class="nav-link">제공자</a>
        <a href="#screenshots" class="nav-link">스크린샷</a>
        <a href="#install" class="nav-link">설치</a>
      </div>
      <div class="flex items-center gap-3">
        <LanguagePicker />
        <a href="https://github.com/wsj-br/transrewrt" target="_blank" rel="noopener" class="btn-secondary py-2 px-4 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="opacity-80">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a href="https://github.com/wsj-br/transrewrt/releases" target="_blank" rel="noopener" class="btn-primary py-2 px-4 text-sm">
          <span>다운로드</span>
        </a>
      </div>
    </div>
  </nav>
  <!-- ═══════════════════════════════════════════════ HERO ══ -->
  <section class="hero-gradient min-h-screen flex flex-col items-center justify-center pt-24 pb-20 px-6 relative overflow-hidden">
    <!-- Grid pattern background -->
    <div class="absolute inset-0 grid-pattern opacity-40 pointer-events-none"></div>
    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-violet-600/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow" style="animation-delay: 1.5s;"></div>
    <div class="relative z-10 text-center max-w-5xl mx-auto">
      <!-- Version badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-sm font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-violet-400 animate-pulse"></span>
        버전 1.3.2 · 오픈 소스 · Apache 2.0
      </div>
      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 leading-tight">
        <span class="text-gradient-hero">번역. 재작성.<br/>변환.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-4 leading-relaxed">
        모든 언어를 구사하고 어떤 스타일로도 생각하는 AI 기반 텍스트 도구입니다.
        하나의 앱. 아홉 개의 AI 제공자. 무한한 가능성.
      </p>
      <p class="text-base text-slate-500 max-w-2xl mx-auto mb-12">
        Windows 및 Linux에서 네이티브 데스크톱 앱으로 실행되거나, 자체 호스팅된 Docker 웹 앱으로 실행됩니다.
        귀하의 데이터는 항상 귀하의 것입니다.
      </p>
      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
        <a href="#install" id="cta-getstarted" class="btn-primary text-base px-8 py-4">
          <span>🚀 무료로 시작하기</span>
        </a>
        <a href="#screenshots" id="cta-seeit" class="btn-secondary text-base px-8 py-4 flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          작동하는 모습 보기
        </a>
        <a href="https://github.com/wsj-br/transrewrt" target="_blank" rel="noopener" id="cta-github" class="btn-secondary text-base px-8 py-4 flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub에서 보기
        </a>
      </div>
      <!-- Banner image -->
      <div class="relative animate-float max-w-4xl mx-auto">
        <div class="absolute -inset-4 bg-gradient-to-r from-violet-600/20 to-blue-600/20 rounded-2xl blur-xl"></div>
        <img
          src="/transrewrt_banner.svg"
          alt="Transrewrt – AI 텍스트 번역 및 재작성 도구"
          class="relative w-full rounded-2xl shadow-2xl border border-white/10"
          loading="eager"
        />
      </div>
    </div>
  </section>
  <!-- ═══════════════════════════════════════════ STATS STRIP ══ -->
  <section class="border-y border-white/[0.06] bg-black/30">
    <div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="stat-block">
        <div class="text-3xl font-black text-gradient-accent mb-1">9+</div>
        <div class="text-slate-400 text-sm">AI 제공자</div>
      </div>
      <div class="stat-block">
        <div class="text-3xl font-black text-gradient-accent mb-1">30+</div>
        <div class="text-slate-400 text-sm">UI 언어</div>
      </div>
      <div class="stat-block">
        <div class="text-3xl font-black text-gradient-accent mb-1">100+</div>
        <div class="text-slate-400 text-sm">대상 언어</div>
      </div>
      <div class="stat-block">
        <div class="text-3xl font-black text-gradient-accent mb-1">무료</div>
        <div class="text-slate-400 text-sm">오픈 소스</div>
      </div>
    </div>
  </section>
  <!-- ═══════════════════════════════════════ FEATURES SECTION ══ -->
  <section id="features" class="py-28 px-6 relative">
    <div class="absolute inset-0 section-gradient pointer-events-none"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <div class="section-divider mb-6"></div>
        <h2 class="text-4xl md:text-5xl font-black mb-4 text-gradient">필요한 모든 것<br/>AI로 텍스트를 마스터하기 위해</h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">네 가지 강력한 모드, 하나의 매끄러운 인터페이스. 빠른 번역이 필요하든 깊이 있는 텍스트 변환이 필요하든, Transrewrt가 도와드립니다.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <!-- Translate -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-violet-500/20 to-violet-500/5 border border-violet-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">🌐</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">번역하기</h3>
              <p class="text-slate-400 text-sm">자동 소스 감지로 수십 개 언어 간에</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {['소스 언어 자동 감지', 'RTL을 포함한 수십 개의 대상 언어', '무료 계층은 OpenRouter 모델을 통해 제공', '형식과 톤을 유지'].map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-violet-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <!-- Rewrite -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-500/5 border border-blue-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">✍️</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">다시 쓰기</h3>
              <p class="text-slate-400 text-sm">AI 정밀도로 명확성을 개선하고 문법을 수정하며 스타일을 변경합니다.</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {['문법 및 철자 수정', '격식 있는 / 비격식적인 / 중립적인 어조', '텍스트를 줄이거나 확장합니다.', '더 명확하게 또는 더 기술적으로 만듭니다.'].map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-blue-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <!-- Transform -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500/20 to-teal-500/5 border border-teal-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">✨</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">변환</h3>
              <p class="text-slate-400 text-sm">무제한 텍스트 변환을 위한 맞춤형 AI 프롬프트</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {['자신의 프롬프트를 생성 및 관리', '프롬프트별 선택적 대상 언어', '요약, 추출, 분류, 형식 지정', '공유 가능한 프롬프트 라이브러리'].map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-teal-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <!-- Dashboard & History -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 border border-amber-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">📊</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">히스토리 및 대시보드</h3>
              <p class="text-slate-400 text-sm">전체 감사 추적, 비용 추적 및 사용 분석</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {['필터가 있는 전체 실행 기록', '기록을 CSV로 내보내기', '모델 및 공급자별 비용 대시보드', 'OpenRouter에 대한 실제 지출 추적'].map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-amber-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <!-- Additional features strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        {[
          { icon: '🌍', title: '30개 이상의 UI 언어', desc: '전체 RTL 지원 포함' },
          { icon: '👥', title: '다중 사용자', desc: '웹 모드의 관리자 역할' },
          { icon: '🔒', title: '자체 호스팅', desc: '당신의 키, 당신의 데이터' },
          { icon: '🖥️', title: '쉬운 + 고급', desc: '간단하거나 전체 모델 제어' },
        ].map(f => (
          <div class="glass-light rounded-xl p-4 text-center hover:border-violet-500/20 transition-all duration-300 border border-transparent">
            <div class="text-2xl mb-2">{f.icon}</div>
            <div class="text-sm font-semibold text-white mb-1">{f.title}</div>
            <div class="text-xs text-slate-500">{f.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- ════════════════════════════════════ AI PROVIDERS SECTION ══ -->
  <section id="providers" class="py-24 px-6 bg-black/20 border-y border-white/[0.04]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <div class="section-divider mb-6"></div>
        <h2 class="text-4xl md:text-5xl font-black mb-4 text-gradient">모든 것과 함께 작동<br/>주요 AI 제공업체</h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          기존 API 키를 연결하고 즉시 시작하세요. 작업별로 제공업체를 전환하세요.
          사용하세요 <strong class="text-violet-300">OpenRouter 또는 Ollama 무료로</strong> — 신용 카드 필요 없음.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        {providers.map(p => (
          <div class="provider-badge" style={`color: ${p.color};`}>
            <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${p.color};`}></span>
            <span class="text-slate-200">{p.name}</span>
            {p.free && <span class="text-xs px-2 py-0.5 rounded-full bg-green-500/10 text-green-400 border border-green-500/20 font-medium">Free</span>}
          </div>
        ))}
      </div>
      <!-- Easy vs Advanced mode -->
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="glass rounded-2xl p-6 border border-violet-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-violet-500/10 flex items-center justify-center text-xl">🎯</div>
            <div>
              <h3 class="font-bold text-white">쉬운 모드</h3>
              <p class="text-xs text-slate-500">시작하기에 완벽합니다</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">선별된 기술 수준: <strong class="text-violet-300">무료</strong>, <strong class="text-violet-300">라이트</strong>, <strong class="text-violet-300">고급</strong>, 그리고 <strong class="text-violet-300">기술적</strong>. 품질 수준을 선택하세요 — 관리할 모델 ID가 없습니다. 구성된 공급자에 대해 사용 가능한 옵션만 표시됩니다.</p>
        </div>
        <div class="glass rounded-2xl p-6 border border-blue-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center text-xl">🔬</div>
            <div>
              <h3 class="font-bold text-white">고급 모드</h3>
              <p class="text-xs text-slate-500">전문 사용자용</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">모든 구성된 공급자에서 <strong class="text-blue-300">전체 모델 카탈로그</strong>에 접근하세요. 각 작업에 사용할 모델을 정확히 선택하세요. 새로운 모델을 실험하거나 비용과 품질을 최적화하는 데 완벽합니다.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- ══════════════════════════════════════ SCREENSHOTS SECTION ══ -->
  <section id="screenshots" class="py-28 px-6 relative overflow-hidden">
    <div class="absolute inset-0 section-gradient pointer-events-none"></div>
