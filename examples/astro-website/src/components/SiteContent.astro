---
import MainLayout from '../layouts/MainLayout.astro';
import LanguagePicker from './LanguagePicker.astro';
import { buildPageData } from '../i18n/page-data';
import { loadFlatBundle, makeT } from '../i18n/t';
import { resolvePageLocale, useTranslations } from '../i18n/utils';

const locale = resolvePageLocale(Astro.currentLocale);
const flat = await loadFlatBundle(locale);
const t = useTranslations(locale, makeT(flat));
const {
  screenshots,
  providers,
  stats,
  translateBullets,
  rewriteBullets,
  transformBullets,
  historyBullets,
  featureStrip,
  dockerFeatures,
  desktopFeatures,
  footerProduct,
  footerResources,
} = buildPageData(t, locale);

const pageTitle = t('AI Text Tool – Translate, Rewrite & Transform');
const pageDescription = t(
  'AI-powered text tool: translate, rewrite, and transform text using multiple AI providers. Available as a desktop app and self-hosted Docker web app.'
);
---
<MainLayout title={pageTitle} description={pageDescription} lang={locale}>

  <!-- ═══════════════════════════════════════════════ NAV ══ -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 glass border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <img src="/logo.svg" alt="Transrewrt Logo" class="w-9 h-7 object-contain transition-all duration-300 group-hover:scale-105" />
        <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-lime-500 via-lime-400 via-orange-400 to-orange-500 bg-clip-text text-transparent">Transrewrt</span>
      </a>
      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="nav-link">{t('Features')}</a>
        <a href="#providers" class="nav-link">{t('Providers')}</a>
        <a href="#screenshots" class="nav-link">{t('Screenshots')}</a>
        <a href="#install" class="nav-link">{t('Install')}</a>
      </div>
      <div class="flex items-center gap-3">
        <LanguagePicker />
        <a href="https://github.com/wsj-br/transrewrt" target="_blank" rel="noopener" class="btn-secondary py-2 px-4 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="opacity-80">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          {t('GitHub')}
        </a>
        <a href="https://github.com/wsj-br/transrewrt/releases" target="_blank" rel="noopener" class="btn-primary py-2 px-4 text-sm">
          <span>{t('Download')}</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════ HERO ══ -->
  <section class="hero-gradient min-h-screen flex flex-col items-center justify-center pt-24 pb-20 px-6 relative overflow-hidden">
    <!-- Grid pattern background -->
    <div class="absolute inset-0 grid-pattern opacity-40 pointer-events-none"></div>
    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-violet-600/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow" style="animation-delay: 1.5s;"></div>

    <div class="relative z-10 text-center max-w-5xl mx-auto">
      <!-- Version badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-sm font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-violet-400 animate-pulse"></span>
        {t('Version 1.3.2 · Open Source · Apache 2.0')}
      </div>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 leading-tight">
        <span class="text-gradient-hero" set:html={t('Translate. Rewrite.<br/>Transform.')} />
      </h1>
      <p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-4 leading-relaxed">
        {t('The AI-powered text tool that speaks every language and thinks in any style. One app. Nine AI providers. Infinite possibilities.')}
      </p>
      <p class="text-base text-slate-500 max-w-2xl mx-auto mb-12">
        {t('Runs as a native desktop app on Windows & Linux, or as a self-hosted Docker web app. Your data stays yours — always.')}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
        <a href="#install" id="cta-getstarted" class="btn-primary text-base px-8 py-4">
          <span>🚀 {t('Get Started Free')}</span>
        </a>
        <a href="#screenshots" id="cta-seeit" class="btn-secondary text-base px-8 py-4 flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          {t('See it in action')}
        </a>
        <a href="https://github.com/wsj-br/transrewrt" target="_blank" rel="noopener" id="cta-github" class="btn-secondary text-base px-8 py-4 flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          {t('View on GitHub')}
        </a>
      </div>

      <!-- Banner image -->
      <div class="relative animate-float max-w-4xl mx-auto">
        <div class="absolute -inset-4 bg-gradient-to-r from-violet-600/20 to-blue-600/20 rounded-2xl blur-xl"></div>
        <img
          src="/transrewrt_banner.png"
          alt={t('Transrewrt – AI text translation and rewriting tool')}
          class="relative w-full rounded-2xl shadow-2xl border border-white/10"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ STATS STRIP ══ -->
  <section class="border-y border-white/[0.06] bg-black/30">
    <div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      {stats.map((s) => (
        <div class="stat-block">
          <div class="text-3xl font-black text-gradient-accent mb-1">{s.value}</div>
          <div class="text-slate-400 text-sm">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════ FEATURES SECTION ══ -->
  <section id="features" class="py-28 px-6 relative">
    <div class="absolute inset-0 section-gradient pointer-events-none"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <div class="section-divider mb-6"></div>
        <h2 class="text-4xl md:text-5xl font-black mb-4 text-gradient" set:html={t('Everything you need<br/>to master text with AI')} />
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">{t('Four powerful modes, one seamless interface. Whether you need a quick translation or a deep text transformation, Transrewrt has you covered.')}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-6">

        <!-- Translate -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-violet-500/20 to-violet-500/5 border border-violet-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">🌐</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">{t('Translate')}</h3>
              <p class="text-slate-400 text-sm">{t('Between dozens of languages with automatic source detection')}</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {translateBullets.map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-violet-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Rewrite -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-500/5 border border-blue-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">✍️</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">{t('Rewrite')}</h3>
              <p class="text-slate-400 text-sm">{t('Improve clarity, fix grammar, and change style with AI precision')}</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {rewriteBullets.map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-blue-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Transform -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500/20 to-teal-500/5 border border-teal-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">✨</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">{t('Transform')}</h3>
              <p class="text-slate-400 text-sm">{t('Custom AI prompts for unlimited text transformations')}</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {transformBullets.map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-teal-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Dashboard & History -->
        <div class="feature-card group">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 border border-amber-500/20 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">📊</div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">{t('History & Dashboard')}</h3>
              <p class="text-slate-400 text-sm">{t('Full audit trail, cost tracking and usage analytics')}</p>
            </div>
          </div>
          <ul class="space-y-2.5 relative z-10">
            {historyBullets.map(item => (
              <li class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-amber-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Additional features strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        {featureStrip.map(f => (
          <div class="glass-light rounded-xl p-4 text-center hover:border-violet-500/20 transition-all duration-300 border border-transparent">
            <div class="text-2xl mb-2">{f.icon}</div>
            <div class="text-sm font-semibold text-white mb-1">{f.title}</div>
            <div class="text-xs text-slate-500">{f.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════ AI PROVIDERS SECTION ══ -->
  <section id="providers" class="py-24 px-6 bg-black/20 border-y border-white/[0.04]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <div class="section-divider mb-6"></div>
        <h2 class="text-4xl md:text-5xl font-black mb-4 text-gradient" set:html={t('Works with every<br/>major AI provider')} />
        <p class="text-slate-400 text-lg max-w-2xl mx-auto" set:html={t('Plug in your existing API keys and start immediately. Switch providers per task. Use <strong class="text-violet-300">OpenRouter or Ollama for free</strong> — no credit card required.')} />
      </div>

      <div class="flex flex-wrap justify-center gap-3 mb-12">
        {providers.map(p => (
          <div class="provider-badge" style={`color: ${p.color};`}>
            <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${p.color};`}></span>
            <span class="text-slate-200">{p.name}</span>
            {p.free && <span class="text-xs px-2 py-0.5 rounded-full bg-green-500/10 text-green-400 border border-green-500/20 font-medium">{t('Free')}</span>}
          </div>
        ))}
      </div>

      <!-- Easy vs Advanced mode -->
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="glass rounded-2xl p-6 border border-violet-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-violet-500/10 flex items-center justify-center text-xl">🎯</div>
            <div>
              <h3 class="font-bold text-white">Easy Mode</h3>
              <p class="text-xs text-slate-500">Perfect for getting started</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">Curated skill tiers: <strong class="text-violet-300">Free</strong>, <strong class="text-violet-300">Lite</strong>, <strong class="text-violet-300">Advanced</strong>, and <strong class="text-violet-300">Technical</strong>. Pick your quality level — no model IDs to manage. Only options available for your configured providers are shown.</p>
        </div>
        <div class="glass rounded-2xl p-6 border border-blue-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center text-xl">🔬</div>
            <div>
              <h3 class="font-bold text-white">Advanced Mode</h3>
              <p class="text-xs text-slate-500">For power users</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">Access the <strong class="text-blue-300">full model catalogue</strong> from every configured provider. Choose exactly which model to use for each task. Perfect for experimenting with new models or optimising cost vs quality.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════ SCREENSHOTS SECTION ══ -->
  <section id="screenshots" class="py-28 px-6 relative overflow-hidden">
    <div class="absolute inset-0 section-gradient pointer-events-none"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-14">
        <div class="section-divider mb-6"></div>
        <h2 class="text-4xl md:text-5xl font-black mb-4 text-gradient">{t('See it in action')}</h2>
        <p class="text-slate-400 text-lg">{t('A clean, intuitive interface for both newcomers and power users.')}</p>
      </div>

      <!-- Tab switcher -->
      <div class="flex flex-wrap justify-center gap-2 mb-10" id="screenshot-tabs">
        {screenshots.map((s, i) => (
          <button
            id={`tab-${i}`}
            class={`tab-btn flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium border border-white/10 text-slate-300 transition-all duration-300 ${i === 0 ? 'active' : ''}`}
            data-index={i}
            onclick={`switchTab(${i})`}
          >
            <span>{s.icon}</span>
            <span>{s.label}</span>
          </button>
        ))}
      </div>

      <!-- Screenshot display -->
      <div class="relative max-w-5xl mx-auto">
        {screenshots.map((s, i) => (
          <div id={`screen-${i}`} class={`screenshot-panel ${i === 0 ? '' : 'hidden'}`}>
            <div class="screenshot-frame mx-auto max-w-max">
              <!-- Window chrome bar -->
              <div class="bg-[#1a1a1f] px-4 py-3 flex items-center gap-2 border-b border-white/[0.06]">
                <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
                <div class="ml-4 text-xs text-slate-500 font-mono">Transrewrt · {s.label}</div>
              </div>
              <img
                src={s.src}
                alt={`Transrewrt ${s.label} screenshot`}
                class="max-w-full h-auto block cursor-zoom-in hover:brightness-110 transition-all duration-200"
                loading={i === 0 ? 'eager' : 'lazy'}
                onclick="openLightbox(this.src)"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ DEPLOYMENT OPTIONS ══ -->
  <section id="install" class="py-28 px-6 bg-black/20 border-y border-white/[0.04] relative">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <div class="section-divider mb-6"></div>
        <h2 class="text-4xl md:text-5xl font-black mb-4 text-gradient">{t('Choose your deployment')}</h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">{t('Run Transrewrt exactly how you want — native desktop app or self-hosted web service. Both options support all AI providers.')}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">

        <!-- Docker -->
        <div class="glass rounded-2xl p-8 border border-blue-500/10 hover:border-blue-500/25 transition-all duration-400 group">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-blue-600/5 border border-blue-500/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <svg width="28" height="28" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M47 20.5c-.4-.3-4.1-2.5-9.5-1.5-.9-5.2-4.7-7.7-4.9-7.9l-1-.6-.7 1c-.8 1.3-2 3.5-2.3 5.9-.5 3.3.3 6.3 2 8.5C28.5 27 26 28 25.3 28H2c-.5 0-1 .5-1 1 0 5.4 1.5 10 4.7 13.5 3.2 3.4 8.1 5.3 14.5 5.3 13 0 22.7-6.1 27.2-17.1 3.1.1 6.3-.7 7.7-3.8l.4-.9-.5-.3z" fill="#2496ED"/>
                <path d="M4 27h5v5H4zm7 0h5v5h-5zm7 0h5v5h-5zm7 0h5v5h-5zm-14-7h5v5H11zm7 0h5v5h-5zm7 0h5v5h-5zm7 0h5v5h-5zm-14-7h5v5H18zm7 0h5v5h-5zm0-7h5v5h-5z" fill="white"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Docker</h3>
              <p class="text-slate-400 text-sm">Recommended · Self-hosted</p>
            </div>
          </div>

          <div class="space-y-3 mb-6">
            {dockerFeatures.map(f => (
              <div class="flex items-center gap-2 text-slate-300 text-sm">
                <svg class="w-4 h-4 text-blue-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {f}
              </div>
            ))}
          </div>

          <div class="code-block p-5">
            <div class="text-slate-500 text-xs mb-3 font-mono">Quick start</div>
            <pre class="text-sm leading-relaxed overflow-x-auto"><code><span class="text-slate-500"># Pull the image</span>
<span class="text-violet-300">docker</span> <span class="text-blue-300">pull</span> ghcr.io/wsj-br/transrewrt:latest

<span class="text-slate-500"># Run with your API key</span>
<span class="text-violet-300">OPENROUTER_API_KEY</span>=sk-or-your-key \
<span class="text-violet-300">docker</span> run -d \
  -p 5000:5000 \
