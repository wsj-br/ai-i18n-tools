{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "ar",
    "es",
    "fr",
    "de",
    "pt-BR"
  ],
  "concurrency": 4,
  "batchConcurrency": 4,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "openrouter": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "translationModels": [
      "qwen/qwen3-235b-a22b-2507",
      "openai/gpt-4o-mini",
      "deepseek/deepseek-v4-flash",
      "anthropic/claude-3-haiku",
      "qwen/qwen3.6-plus",
      "anthropic/claude-3.5-haiku",
      "google/gemini-3-flash-preview",
      "~anthropic/claude-haiku-latest",
      "google/gemma-4-31b-it",
      "~anthropic/claude-sonnet-latest",
      "openai/gpt-5.3-codex"
    ],
    "maxTokens": 8192,
    "temperature": 0.2
  },
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateSVG": false
  },
  "glossary": {
    "userGlossary": "glossary-user.csv",
    "autoAddUserEditedToGlossary": true
  },
  "ui": {
    "sourceRoots": [],
    "stringsJson": "strings.json",
    "flatOutputDir": "./locales"
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "Starlight docs under src/content/docs",
      "contentPaths": [
        "src/content/docs/quick-start.md",
        "src/content/docs/feature-showcase.mdx"
      ],
      "outputDir": "src/content/docs",
      "addFrontmatter": true,
      "docsOutput": {
        "style": "astro-starlight",
        "docsRoot": "src/content/docs",
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Per-locale screenshot folders in public assets",
              "search": "screenshots/[^/]+/",
              "replace": "screenshots/${translatedLocale}/"
            }
          ]
        }
      }
    }
  ]
}