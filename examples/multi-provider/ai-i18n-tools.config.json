{
  "sourceLocale": "pt-BR",
  "targetLocales": [
    "en-GB",
    "hi-Latn",
    "zh-Hans"
  ],
  "concurrency": 2,
  "batchConcurrency": 2,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "requestTimeout": 60,
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "markdown translation compared across providers (Portuguese source)",
      "contentPaths": [
        "markdown-example.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": "."
      }
    }
  ],
  "provider": "openrouter",
  "providers": {
    "openai": {
      "translationModels": [
        "gpt-4o-mini",
        "gpt-4o"
      ],
      "pricing": { "inputPerMTokens": 0.15, "outputPerMTokens": 0.6 },
      "modelPricing": {
        "gpt-4o-mini": { "inputPerMTokens": 0.15, "outputPerMTokens": 0.6 },
        "gpt-4o": { "inputPerMTokens": 2.5, "outputPerMTokens": 10 }
      }
    },
    "anthropic": {
      "translationModels": [
        "claude-haiku-4-5-20251001",
        "claude-opus-4-6"
      ],
      "pricing": { "inputPerMTokens": 1, "outputPerMTokens": 5 },
      "modelPricing": {
        "claude-haiku-4-5-20251001": { "inputPerMTokens": 1, "outputPerMTokens": 5 },
        "claude-opus-4-6": { "inputPerMTokens": 5, "outputPerMTokens": 25 }
      }
    },
    "openrouter": {
      "maxTokens": 4096,
      "requestTimeout": 240,
      "translationModels": [
        "openai/gpt-4o-mini",
        "google/gemma-4-26b-a4b-it"
      ]
    },
    "deepseek": {
      "translationModels": [
        "deepseek-flash",
        "deepseek-v4-pro"
      ],
      "pricing": { "inputPerMTokens": 0.15, "outputPerMTokens": 0.6 },
      "modelPricing": {
        "deepseek-v4-pro": { "inputPerMTokens": 0.66, "outputPerMTokens": 1.98 }
      }
    }
  }
}
