{
  "sourceLocale": "pt-BR",
  "targetLocales": [
    "en-GB",
    "hi-Latn",
    "zh-Hans"
  ],
  "concurrency": 5,
  "batchConcurrency": 5,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "markdown translation compared across providers (Portuguese source)",
      "contentPaths": [
        "markdown-example.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": "."
      }
    }
  ],
  "provider": "nvidia",
  "providers": {
    "openai": {
      "translationModels": [
        "gpt-4o-mini",
        "gpt-4o"
      ],
      "maxTokens": 8192,
      "temperature": 0.2
    },
    "anthropic": {
      "translationModels": [
        "claude-haiku-4-5-20251001",
        "claude-opus-4-6"
      ]
    },
    "nvidia": {
      "translationModels": [
        "openai/gpt-oss-20b",
        "stepfun-ai/step-3.7-flash"
      ]
    },
    "deepseek": {
      "translationModels": [
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ]
    }
  }
}
