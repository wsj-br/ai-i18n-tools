{
  "name": "multi-provider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf .translation-cache translated-docs/",
    "translate:openai": "node ../../bin/ai-i18n-tools.mjs translate-docs -P openai --force",
    "translate:anthropic": "node ../../bin/ai-i18n-tools.mjs translate-docs -P anthropic --force",
    "translate:nvidia": "node ../../bin/ai-i18n-tools.mjs translate-docs -P nvidia --force",
    "translate:deepseek": "node ../../bin/ai-i18n-tools.mjs translate-docs -P deepseek --force",
    "check-models:all": "node ../../bin/ai-i18n-tools.mjs check-models -P openai && node ../../bin/ai-i18n-tools.mjs check-models -P anthropic && node ../../bin/ai-i18n-tools.mjs check-models -P nvidia && node ../../bin/ai-i18n-tools.mjs check-models -P deepseek",
    "check-models:openai": "node ../../bin/ai-i18n-tools.mjs check-models -P openai",
    "check-models:anthropic": "node ../../bin/ai-i18n-tools.mjs check-models -P anthropic",
    "check-models:nvidia": "node ../../bin/ai-i18n-tools.mjs check-models -P nvidia",
    "check-models:deepseek": "node ../../bin/ai-i18n-tools.mjs check-models -P deepseek",
    "clean": "rm -rf .translation-cache translated-docs/"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT"
}
