{
  "name": "multi-provider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf .translation-cache translated-docs/",
    "translate:openai": "ai-i18n-tools translate-docs -P openai --force",
    "translate:anthropic": "ai-i18n-tools translate-docs -P anthropic --force",
    "translate:openrouter": "ai-i18n-tools translate-docs -P openrouter --force",
    "translate:deepseek": "ai-i18n-tools translate-docs -P deepseek --force",
    "check-models:all": "ai-i18n-tools check-models -P openai && ai-i18n-tools check-models -P anthropic && ai-i18n-tools check-models -P openrouter && ai-i18n-tools check-models -P deepseek",
    "check-models:openai": "ai-i18n-tools check-models -P openai",
    "check-models:anthropic": "ai-i18n-tools check-models -P anthropic",
    "check-models:openrouter": "ai-i18n-tools check-models -P openrouter",
    "check-models:deepseek": "ai-i18n-tools check-models -P deepseek",
    "clean": "rm -rf .translation-cache translated-docs/"
  },
  "dependencies": {
    "ai-i18n-tools": "^1.9.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT"
}
