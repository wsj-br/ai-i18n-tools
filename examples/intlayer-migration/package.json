{
  "name": "intlayer-migration-example",
  "version": "1.0.0",
  "description": "Example Intlayer app for practicing migrate-intlayer",
  "type": "module",
  "private": true,
  "scripts": {
    "reset": "node scripts/reset.mjs",
    "dev": "vite --port 3091",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3091",
    "migrate:dry": "ai-i18n-tools migrate-intlayer src --report ./migrate-intlayer-report.md",
    "migrate:write": "ai-i18n-tools migrate-intlayer src --write --report ./migrate-intlayer-report.md",
    "i18n:extract": "ai-i18n-tools extract",
    "i18n:translate-ui": "ai-i18n-tools translate-ui",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:locales": "ai-i18n-tools generate-ui-languages"
  },
  "dependencies": {
    "ai-i18n-tools": "^1.10.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT"
}
