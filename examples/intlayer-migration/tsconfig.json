{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "intlayer": ["src/shim/intlayer.ts"],
      "react-intlayer": ["src/shim/react-intlayer.tsx"]
    }
  },
  "include": ["src"],
  "exclude": ["intlayer-pristine", "node_modules", "dist"]
}
