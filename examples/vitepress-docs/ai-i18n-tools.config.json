{
  "sourceLocale": "en-GB",
  "targetLocales": ["pt-BR", "zh-Hans"],
  "concurrency": 3,
  "batchConcurrency": 3,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "glossary": {
    "userGlossary": "glossary-user.csv"
  },
  "docs": [
    {
      "description": "VitePress docs (English source at docs/, translations under docs/{locale}/)",
      "contentPaths": ["docs/index.md", "docs/guide"],
      "outputDir": "docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "vitepress",
        "docsRoot": "docs",
        "vitepressThemeCatalog": {
          "configPath": "docs/.vitepress/config.mts",
          "catalogPath": "docs/.vitepress/i18n/theme.en.json"
        }
      }
    }
  ],
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-2.5-flash",
        "openai/gpt-4o-mini",
        "z-ai/glm-5.2",
        "~anthropic/claude-sonnet-latest"
      ],
      "maxTokens": 4096,
      "temperature": 0.2
    }
  },
  "provider": "openrouter"
}
