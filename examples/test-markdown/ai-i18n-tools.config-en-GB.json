{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "pt-BR",
    "hi",
    "ja",
    "ko",
    "zh-Hans"
  ],
  "concurrency": 5,
  "batchConcurrency": 5,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "test for a markdown only translation (English source)",
      "contentPaths": [
        "test-markdown-en-GB.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": "."
      }
    }
  ],
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-2.5-flash-lite",	
        "openai/gpt-4o-mini"
      ],
      "maxTokens": 8192,
      "temperature": 0.2
    }
  },
  "provider": "openrouter"
}
