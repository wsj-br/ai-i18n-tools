{
  "sourceLocale": "pt-BR",
  "targetLocales": ["en-GB", "hi", "ja", "ko", "zh-CN"],
  "concurrency": 5,
  "batchConcurrency": 5,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "openrouter": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "translationModels": [
      "qwen/qwen3-235b-a22b-2507",
      "openai/gpt-4o-mini"
    ],
    "maxTokens": 8192,
    "temperature": 0.2
  },
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "test for a markdown only translation (Portuguese source)",
      "contentPaths": [
        "test-markdown.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": "."
      }
    }
  ]
}
