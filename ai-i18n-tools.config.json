{
  "sourceLocale": "en-GB",
  "targetLocales": ["de", "es", "fr", "hi", "ja", "ko", "pt-BR", "zh-Hans", "zh-Hant"],
  "concurrency": 4,
  "batchConcurrency": 4,
  "uiBatchConcurrency": 4,
  "fileConcurrency": 2,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "provider": "openrouter",
  "providers": {
    "openrouter": {
      "translationModels": [
        "qwen/qwen3.7-max",
        "~anthropic/claude-sonnet-latest",
        "openai/gpt-5.4",
        "google/gemini-3.5-flash",
        "tencent/hy-mt2-30b-a3b",
        "mistralai/mistral-large",
        "openai/gpt-4o-mini",
        "cohere/command-r-plus-08-2024",
        "qwen/qwen-2.5-72b-instruct"  
      ],
      "uiModels": [
        "~anthropic/claude-sonnet-latest",
        "openai/gpt-5.4"
      ],
      "maxTokens": 8192,
      "temperature": 0.2,
      "requestTimeout": 60
    }
  },
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "README.md (flat, GitHub-facing translations)",
      "contentPaths": ["README.md"],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": ".",
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Prefix GitHub Pages doc links with the target locale",
              "search": "https://wsj-br\\.github\\.io/ai-i18n-tools/",
              "replace": "https://wsj-br.github.io/ai-i18n-tools/${translatedLocale}/"
            }
          ],
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    },
    {
      "description": "VitePress website content",
      "contentPaths": ["docs/index.md", "docs/guide", "docs/reference", "docs/examples.md"],
      "outputDir": "docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "vitepress",
        "docsRoot": "docs",
        "rewriteVitepressLinks": true,
        "vitepressThemeCatalog": {
          "configPath": "docs/.vitepress/config.mts",
          "catalogPath": "docs/.vitepress/i18n/theme.en.json"
        }
      }
    }
  ]
}
