{
  "sourceLocale": "en-GB",
  "targetLocales": ["de", "es", "fr", "hi", "ja", "ko", "pt-BR", "zh-Hans", "zh-Hant"],
  "concurrency": 5,
  "batchConcurrency": 5,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "provider": "openrouter",
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-2.5-flash",
        "meta-llama/llama-3.3-70b-instruct",
        "openai/gpt-4o-mini",
        "google/gemma-4-26b-a4b-it",
        "~anthropic/claude-haiku-latest",
        "z-ai/glm-5.2",
        "google/gemini-3.5-flash",
        "~anthropic/claude-sonnet-latest"
      ],
      "uiModels": [
        "~anthropic/claude-sonnet-latest",
        "z-ai/glm-5.2"
      ],
      "localeModels": [
        { "locale": "ja",      "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "ko",      "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "zh-Hans", "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "zh-Hant", "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] }
      ],
      "maxTokens": 8192,
      "temperature": 0.2,
      "requestTimeoutMs": 60000
    }
  },
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "README.md (flat, GitHub-facing translations)",
      "contentPaths": ["README.md"],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": ".",
        "postProcessing": {
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    },
    {
      "description": "VitePress website content",
      "contentPaths": ["docs/index.md", "docs/guide", "docs/reference", "docs/examples.md"],
      "outputDir": "docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "vitepress",
        "docsRoot": "docs",
        "rewriteVitepressLinks": true,
        "vitepressThemeCatalog": {
          "configPath": "docs/.vitepress/config.mts",
          "catalogPath": "docs/.vitepress/i18n/theme.en.json"
        }
      }
    }
  ]
}
