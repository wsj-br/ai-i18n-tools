{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "de",
    "es",
    "fr",
    "hi",
    "ja",
    "ko",
    "pt-BR",
    "zh-Hans",
    "zh-Hant"
  ],
  "concurrency": 4,
  "batchConcurrency": 4,
  "uiBatchConcurrency": 5,
  "fileConcurrency": 2,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "provider": "cheaperinference",
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-3.1-flash-lite-preview",
        "google/gemini-2.5-flash",
        "google/gemma-4-31b-it",
        "deepseek/deepseek-v4-flash",
        "deepseek/deepseek-chat-v3.1",
        "deepseek/deepseek-v3.2-exp",
        "openai/gpt-5-mini",
        "google/gemma-3-27b-it",
        "z-ai/glm-4.5-air",
        "meta-llama/llama-3.1-70b-instruct"
      ],
      "uiModels": [
        "~anthropic/claude-sonnet-latest",
        "qwen/qwen3.7-max"
      ]
    },
    "cheaperinference": {
      "translationModels": [
        "gemini-2.5-flash",
        "deepseek-v4-flash",
        "gemini-2.5-pro",
        "gpt-5-mini",
        "glm-4.5-air",
        "gpt-oss-120b",
        "gpt-5-nano",
        "gpt-5.4",
        "gpt-5",
        "gpt-5.2"
      ],
      "requestTimeout": 120
    }
  },
  "features": {
    "translateDocs": true
  },
  "cacheDir": ".translation-cache",
  "ui": {
    "description": "CLI and dashboard",
    "sourceRoots": [
      "src/api",
      "src/cli",
      "src/server",
      "src/dashboard-app"
    ],
    "stringsJson": "src/i18n/strings.json",
    "flatOutputDir": "src/i18n/locales",
    "languagesManifestPath": "src/i18n/locales/ui-languages.json",
    "uiGlossary": false,
    "uiExtractor": {
      "extensions": [
        ".ts",
        ".js",
        ".html"
      ],
      "funcNames": [
        "t"
      ],
      "includePackageDescription": false
    }
  },
  "docs": [
    {
      "description": "README.md (flat, GitHub-facing translations)",
      "contentPaths": [
        "README.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": ".",
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Prefix GitHub Pages doc links with the target locale",
              "search": "https://wsj-br\\.github\\.io/ai-i18n-tools/",
              "replace": "https://wsj-br.github.io/ai-i18n-tools/${translatedLocale}/"
            }
          ],
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    },
    {
      "description": "VitePress website content",
      "contentPaths": [
        "docs/index.md",
        "docs/guide",
        "docs/reference",
        "docs/examples.md"
      ],
      "outputDir": "docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "vitepress",
        "docsRoot": "docs",
        "rewriteVitepressLinks": true,
        "vitepressThemeCatalog": {
          "configPath": "docs/.vitepress/config.mts",
          "catalogPath": "docs/.vitepress/i18n/theme.en.json"
        }
      }
    }
  ]
}
