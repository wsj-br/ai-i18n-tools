{
  "sourceLocale": "en-GB",
  "targetLocales": ["de", "es", "fr", "hi-Latn", "ja", "ko", "pt-BR", "zh-Hans", "zh-Hant"],
  "concurrency": 5,
  "batchConcurrency": 5,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "provider": "openrouter",
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-2.5-flash",
        "meta-llama/llama-3.3-70b-instruct",
        "qwen/qwen-2.5-72b-instruct",
        "openai/gpt-4o-mini",
        "deepseek/deepseek-v4-flash",
        "anthropic/claude-3-haiku",
        "z-ai/glm-4.7-flash",
        "anthropic/claude-3.5-haiku",
        "google/gemini-3-flash-preview",
        "~anthropic/claude-haiku-latest",
        "google/gemma-4-31b-it",
        "~anthropic/claude-sonnet-latest",
        "openai/gpt-5.3-codex"
      ],
      "maxTokens": 8192,
      "temperature": 0.2
    }
  },
  "features": {
    "translateUIStrings": false,
    "translateDocs": true,
    "translateJson": false,
    "translateSVG": false
  },
  "cacheDir": ".translation-cache",
  "docs": [
    {
      "description": "README and docs/ markdown only (no UI strings pipeline)",
      "contentPaths": [
        "README.md",
        "docs/GETTING_STARTED.md",
        "docs/PACKAGE_OVERVIEW.md",
        "docs/LOCALE-ASSETS-GUIDE.md"
      ],
      "outputDir": "translated-docs",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "flatPreserveRelativeDir": true,
        "linkRewriteDocsRoot": ".",
        "postProcessing": {
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    }
  ]
}
